# Backend-private environment variables.
# NEVER expose these to the frontend or commit real values.

NODE_ENV=development

# Server port
PORT=4000

# PostgreSQL connection string (Prisma).
# DATABASE_URL is used by Prisma Client at runtime and Prisma Migrate;
# DIRECT_URL is the non-pooled connection (set it to the same value locally).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# JWT auth
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
OTP_EXPIRES_MINUTES=10

# Public URL of the frontend (used in emails/links)
CLIENT_URL=http://localhost:3000

# SMTP (optional in dev — codes are logged to console instead)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cloudinary (media storage) — format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
