# Backend-private environment variables.
# NEVER expose these to the frontend or commit real values.

NODE_ENV=development

# Server port
PORT=4000

# PostgreSQL connection string (Prisma).
# DATABASE_URL is used by Prisma Client at runtime and Prisma Migrate;
# DIRECT_URL is the non-pooled connection (set it to the same value locally).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public

# Secret used to sign JWT access tokens (HS256). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=[GENERATE-A-RANDOM-SECRET-AT-LEAST-32-CHARACTERS]

# Access token lifetime, in jsonwebtoken notation (e.g. 15m, 1h, 7d, 86400)
JWT_ACCESS_EXPIRES_IN=15m

# Refresh (session) token lifetime in days
REFRESH_TOKEN_EXPIRES_DAYS=30

# OTP verification code lifetime in minutes
OTP_EXPIRES_MINUTES=10

# Base URL of the frontend (used in emails)
CLIENT_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SMTP (email delivery)
# ---------------------------------------------------------------------------
# If unset, the backend falls back to printing emails to the console, which
# is convenient for development. SMTP is REQUIRED in production.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=Example <no-reply@example.com>
